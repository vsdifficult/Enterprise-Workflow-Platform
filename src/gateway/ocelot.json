{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5006
        }
      ],
      "UpstreamPathTemplate": "/gateway/auth/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "SwaggerKey": "auth"
    },
    {
      "DownstreamPathTemplate": "/api/tasks/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5152
        }
      ],
      "UpstreamPathTemplate": "/gateway/users/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "SwaggerKey": "users"
    }
  ],
      "SwaggerEndPoints": [
        {
          "Key": "auth",
          "Config": [
            {
              "Name": "Auth API",
              "Version": "v1",
              "Url": "http://localhost:5006/swagger/v1/swagger.json"
            }
          ]
        },
        {
          "Key": "users",
          "Config": [
            {
              "Name": "Users API",
              "Version": "v1",
              "Url": "http://localhost:5152/swagger/v1/swagger.json"
            }
          ]
        }
      ],  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5130"
  }
}
